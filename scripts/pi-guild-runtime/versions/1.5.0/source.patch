@@ -0,0 +1,244 @@
+import { beginToolRegistryWrite } from "./tool-registry-write.ts";
+import type {
+	AtomicOwnedTools,
+	AtomicOwnedToolsResult,
+	AtomicOwnedToolUpdate,
+	Extension,
+	ExtensionRuntime,
+	ToolDefinition,
+} from "./types.ts";
+
+type Retirement = "superseded" | "core-rebind" | "runtime-invalidate";
+interface Backend {
+	collides(owner: Extension, names: ReadonlySet<string>): boolean;
+	update(owner: Extension, batch: readonly AtomicOwnedToolUpdate[], current: () => boolean): AtomicOwnedToolsResult;
+}
+interface Claim {
+	owner: Extension;
+	names: Set<string>;
+	live: boolean;
+	retire: (reason: Retirement) => void;
+}
+interface Coordinator {
+	backend?: Backend;
+	epoch: number;
+	claims: Set<Claim>;
+}
+const coordinators = new WeakMap<ExtensionRuntime, Coordinator>();
+function coordinator(runtime: ExtensionRuntime): Coordinator {
+	let state = coordinators.get(runtime);
+	if (!state) {
+		state = { epoch: 0, claims: new Set() };
+		coordinators.set(runtime, state);
+	}
+	return state;
+}
+function detach(state: Coordinator, claim: Claim): void {
+	claim.live = false;
+	state.claims.delete(claim);
+}
+function notify(claim: Claim, reason: Retirement): void {
+	try {
+		// A callback may return a promise despite its void signature. Contain both failure forms.
+		void Promise.resolve(claim.retire(reason)).catch(() => {});
+	} catch {
+		/* Retirement is a fence, not a veto. */
+	}
+}
+export function retireAtomicOwnedTools(runtime: ExtensionRuntime, reason: Retirement): void {
+	const state = coordinator(runtime);
+	state.epoch++;
+	state.backend = undefined;
+	const claims = [...state.claims];
+	for (const claim of claims) detach(state, claim);
+	for (const claim of claims) notify(claim, reason);
+}
+export function retireLegacyOwnedTool(runtime: ExtensionRuntime, name: string): boolean {
+	const state = coordinator(runtime);
+	const claims = [...state.claims].filter((claim) => claim.names.has(name));
+	if (!claims.length) return true;
+	const epoch = ++state.epoch;
+	for (const claim of claims) detach(state, claim);
+	for (const claim of claims) notify(claim, "superseded");
+	return state.epoch === epoch;
+}
+export function bindAtomicOwnedToolsBackend(runtime: ExtensionRuntime, backend: Backend): void {
+	coordinator(runtime).backend = backend;
+}
+
+// Trusted in-process metadata: copy values, not JSON, so TypeBox symbols/functions survive.
+// Only schemas are recursively copied; other nested extension metadata remains shared.
+function snapshotSchema(value: unknown, check: () => void, seen = new Map<object, object>()): unknown {
+	if (!value || typeof value !== "object") return value;
+	const previous = seen.get(value);
+	if (previous) return previous;
+	const prototype = Object.getPrototypeOf(value);
+	check();
+	const copy = Array.isArray(value) ? [] : Object.create(prototype);
+	seen.set(value, copy);
+	const keys = Reflect.ownKeys(value);
+	check();
+	for (const key of keys) {
+		if (Array.isArray(value) && key === "length") continue;
+		const field = Reflect.get(value, key);
+		check();
+		Object.defineProperty(copy, key, {
+			value: snapshotSchema(field, check, seen),
+			enumerable: true,
+			writable: true,
+			configurable: true,
+		});
+	}
+	return copy;
+}
+function snapshotDefinition(definition: ToolDefinition, check: () => void): ToolDefinition {
+	const keys = new Set<PropertyKey>();
+	const seen = new Set<object>();
+	let prototype: object | null = definition;
+	while (prototype && prototype !== Object.prototype && !seen.has(prototype)) {
+		seen.add(prototype);
+		const ownKeys = Reflect.ownKeys(prototype);
+		check();
+		for (const key of ownKeys) keys.add(key);
+		prototype = Object.getPrototypeOf(prototype);
+		check();
+	}
+	const copy = {} as ToolDefinition;
+	for (const key of keys) {
+		const value = Reflect.get(definition, key);
+		check();
+		Object.defineProperty(copy, key, { value, enumerable: true, writable: true, configurable: true });
+	}
+	copy.parameters = snapshotSchema(copy.parameters, check) as ToolDefinition["parameters"];
+	if (copy.outputSchema)
+		copy.outputSchema = snapshotSchema(copy.outputSchema, check) as ToolDefinition["outputSchema"];
+	return copy;
+}
+
+/** Factory identity is captured by the loader, never supplied by the extension. */
+export function createAtomicOwnedTools(
+	runtime: ExtensionRuntime,
+	owner: Extension,
+	assertActive: () => void,
+): AtomicOwnedTools {
+	const state = coordinator(runtime);
+	return {
+		protocol: "pi-atomic-owned-tools-v1",
