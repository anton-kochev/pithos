+import type { ExtensionRuntime } from "./types.ts";
+
+// Internal only: validation failures are writes too. Keep this out of ExtensionAPI until
+// the owned-tools coordinator can enforce ownership and retirement as well as revision.
+const writers = new WeakMap<ExtensionRuntime, () => () => boolean>();
+
+export function bindToolRegistryWriter(runtime: ExtensionRuntime, begin: () => () => boolean): void {
+	writers.set(runtime, begin);
+}
+
+export function beginToolRegistryWrite(runtime: ExtensionRuntime): () => boolean {
+	return writers.get(runtime)?.() ?? (() => true);
+}
