@@ -0,0 +1,428 @@
+export type CommitState = "none" | "committed" | "unknown";
+export interface ContinuationResult {
+	outcome: "completed" | "revoked" | "error";
+	commitState: CommitState;
+	started: boolean;
+}
+export interface ContinuationControl {
+	/** Check immediately before callback-free owned append. No await/callout may precede markCommitted. */
+	canCommit(): boolean;
+	/** Call only after successful append/context synchronization, before public history events. */
+	markCommitted(): boolean;
+	/** Report partial persistence failure, even if revocation occurred during the failed append. */
+	markCommitUnknown(): void;
+	/** Host must install token ownership and enter the native run without a callout gap after success. */
+	markStarted(): boolean;
+}
+export interface ContinuationRequest {
+	readonly sequence: number;
+	readonly content: string;
+	readonly token: object;
+}
+export interface ContinuationHost {
+	/** Both predicates are pure, synchronous, nonthrowing local reads. */
+	isCurrent(): boolean;
+	/** Unlike transient input busy state, unavailable authority makes captured facades permanently stale. */
+	isAuthorityAvailable?(): boolean;
+	isEligibleIdle(): boolean;
+	schedule?(run: () => void): void;
+	/** Own preparation/run/cleanup, excluding separately submitted native actions and receipt subscribers. */
+	dispatch(request: ContinuationRequest, control: ContinuationControl): void | Promise<void>;
+	/** Called after actual dispatch cleanup and receipt/closure publication; transfers foreign work to the host. */
+	onDispatchFinished?(): void;
+	/** Synchronous cancellation of ONLY the matching native run; no asynchronous return value. */
+	cancel(token: object): void;
+	/** Non-owning observation after asynchronous reservation cleanup releases capacity; never an automatic wake. */
+	onIdleCandidate?(): void;
+}
+export interface ContinuationReceipt {
+	/** Revoke this request only; cancel a matching started run without closing its owner. */
+	revoke(): void;
+	readonly finished: Promise<ContinuationResult>;
+	readonly committed: Promise<CommitState>;
+	readonly started: Promise<boolean>;
+}
+export type Acceptance =
+	| { status: "accepted"; receipt: ContinuationReceipt }
+	| { status: "busy" | "stale" | "invalid" };
+export interface ContinuationLease {
+	tryAccept(sequence: number, content: string): Acceptance;
+	close(): void;
+	/** Replaces the single non-owning observer; registration itself does not signal idle. */
+	onIdle(callback: () => void | Promise<void>): void;
+	readonly closed: Promise<void>;
+}
+
+export interface ContinuationAuthority {
+	open(): ContinuationLease | undefined;
+}
+export interface ParentContinuation {
+	capture(): ContinuationAuthority;
+	/** Admission-only fence. Release resumes the same reserved dispatch, never creates a new request. */
+	beginControl(): () => void;
+	/** Native input priority: revoke only a nonstarted request, preserving owner authority. */
+	revokePending(): void;
+	invalidateAll(): void;
+	notifyIdle(): void;
+}
+
+/**
+ * Internal admission state only, not persistence or AgentSession integration.
+ * Host retains this coordinator; context consumers receive only capture()'s epoch-bound facade.
+ * Epoch-retiring transitions must invalidateAll before callouts; native input uses revokePending. New capture is fresh host authority,
+ * not permission to replay interrupted intent. Receipts never imply model read/usage.
+ */
+export function createParentContinuation(host: ContinuationHost): ParentContinuation {
+	let busy = false;
+	let controls = 0;
+	let parkedDispatch: (() => void) | undefined;
+	let revokePending: (() => void) | undefined;
+	let reservation = {};
+	let epoch = {};
+	const leases = new Set<() => (() => void) | undefined>();
+	const observers = new Map<() => (() => void) | undefined, () => void | Promise<void>>();
+	let idleEdge = false;
+	return {
+		beginControl() {
+			controls++;
+			this.notifyIdle();
+			let released = false;
+			return () => {
+				if (released) return;
+				released = true;
+				controls--;
+				if (controls === 0) {
+					const resume = parkedDispatch;
+					parkedDispatch = undefined;
+					resume?.();
+				}
+				this.notifyIdle();
+			};
+		},
+		revokePending() {
+			revokePending?.();
+		},
+		/** Notify on host eligibility transitions (including busy). Cleanup never emits idle itself. */
+		notifyIdle() {
+			const eligible = !busy && controls === 0 && host.isCurrent() && host.isEligibleIdle();
+			if (!eligible) {
+				idleEdge = false;
+				return;
+			}
+			if (idleEdge) return;
+			idleEdge = true;
+			const snapshot = [...observers];
+			queueMicrotask(() => {
+				for (const [index, [owner, callback]] of snapshot.entries()) {
+					if (
+						!leases.has(owner) ||
+						observers.get(owner) !== callback ||
+						busy ||
+						controls > 0 ||
+						!host.isCurrent() ||
+						!host.isEligibleIdle()
+					)
+						continue;
+					const before = reservation;
+					try {
+						Promise.resolve(callback()).catch(() => {});
+					} catch {
+						/* Observers do not own cleanup. */
+					}
+					// A synchronous close or scheduling failure still consumes this notification turn.
+					if (reservation !== before) {
+						// Map order is the bounded round-robin cursor: move visited live owners to the tail.
+						// Read current callbacks so replacement/disposal during notification stays authoritative.
+						for (const [visited] of snapshot.slice(0, index + 1)) {
+							const current = observers.get(visited);
+							if (!current) continue;
+							observers.delete(visited);
+							observers.set(visited, current);
+						}
+						break;
+					}
+				}
+			});
+		},
+		invalidateAll() {
+			epoch = {};
+			idleEdge = false;
+			// Detach every old owner before any cancellation callback can reenter.
+			const cleanup = [...leases].map((fence) => fence());
+			for (const cancel of cleanup) cancel?.();
+		},
+		capture() {
+			const captured = epoch;
+			const available = host.isAuthorityAvailable?.() ?? true;
+			return {
+				open: (): ContinuationLease | undefined => {
+					if (
+						!available ||
+						captured !== epoch ||
+						leases.size >= 16 ||
+						!host.isCurrent() ||
+						host.isAuthorityAvailable?.() === false
+					)
+						return undefined;
+					let active = true;
+					let lastSequence = 0;
+					let closeDone!: () => void;
+					const closed = new Promise<void>((resolve) => {
+						closeDone = resolve;
+					});
+					let revoke: (() => void) | undefined;
+					const fence = () => {
+						if (!active) return undefined;
+						active = false;
+						leases.delete(fence);
+						observers.delete(fence);
+						return () => {
+							if (revoke) revoke();
+							else closeDone();
+						};
+					};
+					leases.add(fence);
+					return {
+						closed,
+						onIdle(callback) {
+							if (active) observers.set(fence, callback);
+						},
+						close() {
+							fence()?.();
+						},
+						tryAccept(sequence, content) {
+							if (!active || !host.isCurrent()) return { status: "stale" };
+							if (busy || controls > 0 || !host.isEligibleIdle()) return { status: "busy" };
+							if (
+								!Number.isSafeInteger(sequence) ||
+								sequence <= lastSequence ||
+								typeof content !== "string" ||
+								content.length === 0 ||
+								content.length > 8192 ||
+								new TextEncoder().encode(content).length > 8192
+							)
+								return { status: "invalid" };
+							lastSequence = sequence;
+							busy = true;
+							reservation = {};
+							idleEdge = false;
+							let resolve!: (result: ContinuationResult) => void;
+							const finished = new Promise<ContinuationResult>((done) => {
+								resolve = done;
+							});
+							let commitDone!: (state: CommitState) => void;
+							let startDone!: (started: boolean) => void;
+							const committed = new Promise<CommitState>((done) => {
+								commitDone = done;
+							});
+							const startReceipt = new Promise<boolean>((done) => {
+								startDone = done;
+							});
+							let commitState: CommitState = "none";
+							let started = false;
+							let preparing = false;
+							let settled = false;
+							let requestRevoked = false;
+							const token = Object.freeze({});
+							const finish = (error = false) => {
+								if (settled) return;
+								settled = true;
+								parkedDispatch = undefined;
+								busy = false;
+								revoke = undefined;
+								revokePending = undefined;
+								commitDone(commitState);
+								startDone(started);
+								resolve({
+									outcome: error
+										? "error"
+										: !requestRevoked && active && host.isCurrent()
+											? "completed"
+											: "revoked",
+									commitState,
+									started,
+								});
+								if (!active) closeDone();
+								// Reserved cancellation is synchronous: reporting it here could spin an idle
+								// observer that accepts then revokes. Native entry owns that idle transition.
+								if (preparing) {
+									try {
+										host.onDispatchFinished?.();
+										host.onIdleCandidate?.();
+									} catch {
+										/* Host observation cannot change the terminal receipt. */
+									}
+								}
+							};
+							const revokeRequest = () => {
+								if (settled || requestRevoked) return;
+								requestRevoked = true;
+								if (started) {
+									try {
+										host.cancel(token);
+									} catch {
+										/* Fencing must survive host cancellation errors. */
+									}
+								}
+								if (!preparing) finish();
+							};
+							revoke = revokeRequest;
+							// Preparation is fenced, not aborted: the host must still settle dispatch/cleanup.
+							revokePending = () => {
+								if (!started) revokeRequest();
+							};
+							// Even an inline/reentrant scheduler cannot dispatch before tryAccept returns.
+							const run = () => {
+								queueMicrotask(() => {
+									if (settled || preparing) return;
+									preparing = true;
+									let parked = false;
+									Promise.resolve()
+										.then(() => {
+											if (requestRevoked || settled) return;
+											if (controls > 0) {
+												// No host work has begun: retain capacity without joining fictitious cleanup.
+												preparing = false;
+												parked = true;
+												parkedDispatch = run;
+												return;
+											}
+											if (!active || !host.isCurrent() || !host.isEligibleIdle()) {
+												fence()?.();
+												return;
+											}
+											return host.dispatch(Object.freeze({ sequence, content, token }), {
+												canCommit: () =>
+													!requestRevoked &&
+													active &&
+													host.isCurrent() &&
+													!settled &&
+													commitState === "none",
+												markCommitted: () => {
+													if (
+														requestRevoked ||
+														!active ||
+														!host.isCurrent() ||
+														settled ||
+														commitState !== "none"
+													)
+														return false;
+													commitState = "committed";
+													commitDone(commitState);
+													return true;
+												},
+												markCommitUnknown: () => {
+													if (!settled && commitState === "none") {
+														commitState = "unknown";
+														commitDone(commitState);
+													}
+												},
+												markStarted: () => {
+													if (
+														requestRevoked ||
+														!active ||
+														!host.isCurrent() ||
+														settled ||
+														started ||
+														commitState !== "committed"
+													)
+														return false;
+													started = true;
+													startDone(true);
+													return true;
+												},
+											});
+										})
+										.then(
+											() => {
+												if (!parked) finish();
+											},
+											() => finish(true),
+										);
+								});
+							};
+							try {
+								(host.schedule ?? queueMicrotask)(run);
+							} catch {
+								finish(true);
+							}
+							return {
+								status: "accepted",
+								receipt: { finished, committed, started: startReceipt, revoke: revokeRequest },
+							};
+						},
+					};
+				},
+			};
+		},
+	};
+}
+
+/** Internal lifecycle gate. Register sessions before building or binding extension contexts. */
+export function createContinuationGate() {
+	let transitions = 0;
+	let inputs = 0;
+	let shutdown = false;
+	type Member = Pick<ParentContinuation, "invalidateAll" | "revokePending" | "notifyIdle" | "beginControl">;
+	const members = new Set<{ member: Member }>();
+	const controls = new Set<Map<{ member: Member }, () => void>>();
+	return {
+		isAuthorityAvailable: () => !shutdown && transitions === 0,
+		isBusy: () => shutdown || transitions > 0 || inputs > 0 || controls.size > 0,
+		beginControl() {
+			const releases = new Map<{ member: Member }, () => void>();
+			controls.add(releases);
+			for (const registration of members) releases.set(registration, registration.member.beginControl());
+			return () => {
+				if (!controls.delete(releases)) return;
+				for (const release of releases.values()) release();
+				releases.clear();
+			};
+		},
+		beginInput() {
+			inputs++;
+			for (const { member } of [...members]) member.revokePending();
+			for (const { member } of [...members]) member.notifyIdle();
+			let released = false;
+			return () => {
+				if (released) return;
+				released = true;
+				inputs--;
+				for (const { member } of [...members]) member.notifyIdle();
+			};
+		},
+		requestShutdown() {
+			if (shutdown) return;
+			shutdown = true;
+			for (const { member } of [...members]) member.invalidateAll();
+		},
+		register(member: Member) {
+			// Each registration owns its releases; an old detach cannot release a replacement.
+			const registration = { member };
+			members.add(registration);
+			for (const releases of controls) releases.set(registration, member.beginControl());
+			return () => {
+				if (!members.delete(registration)) return;
+				for (const releases of controls) {
+					const release = releases.get(registration);
+					releases.delete(registration);
+					release?.();
+				}
+			};
+		},
+		beginTransition() {
+			transitions++;
+			for (const { member } of [...members]) member.invalidateAll();
+			let released = false;
+			return () => {
+				if (released) return;
+				released = true;
+				// Retire contexts created by lifecycle callbacks before exposing idle again.
+				for (const { member } of [...members]) member.invalidateAll();
+				transitions--;
+				for (const { member } of [...members]) member.notifyIdle();
+			};
+		},
+	};
+}
+export type ContinuationGate = ReturnType<typeof createContinuationGate>;
